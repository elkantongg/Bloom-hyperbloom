{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public && printf 'User-agent: *\\nAllow: /\\n' > public/robots.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{index.html,styles.css,icon.svg,js/**,search/sg-places.json.gz,db/schema.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
